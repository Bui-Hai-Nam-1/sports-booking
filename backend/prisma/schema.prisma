generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum VenueStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PricingType {
  STANDARD
  WEEKEND
  PEAK
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues    Venue[]
  bookings  Booking[]
  reviews   Review[]
}

model Venue {
  id          String      @id @default(cuid())
  name        String
  address     String
  description String?
  imageUrls   String[]    @default([])
  sportTypes  String[]    @default([])
  status      VenueStatus @default(PENDING)
  isActive    Boolean     @default(true)
  ownerId     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner        User               @relation(fields: [ownerId], references: [id])
  courts       Court[]
  openingHours VenueOpeningHour[]

  @@index([status, isActive])
}

model Court {
  id        String   @id @default(cuid())
  name      String
  sportType String
  isActive  Boolean  @default(true)
  venueId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue             Venue              @relation(fields: [venueId], references: [id])
  bookings          Booking[]
  reviews           Review[]
  pricingRules      PricingRule[]
  maintenanceBlocks MaintenanceBlock[]

  @@index([venueId, isActive, sportType])
}

model VenueOpeningHour {
  id       String  @id @default(cuid())
  weekday  Int
  opensAt  String
  closesAt String
  isClosed Boolean @default(false)
  venueId  String
  venue    Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, weekday])
}

model PricingRule {
  id           String      @id @default(cuid())
  type         PricingType
  pricePerHour Decimal     @db.Decimal(12, 2)
  weekday      Int?
  startsAt     String
  endsAt       String
  courtId      String
  court        Court       @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([courtId, type, weekday])
}

model MaintenanceBlock {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  reason    String
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([courtId, startAt, endAt])
}

model Booking {
  id            String        @id @default(cuid())
  startAt       DateTime
  endAt         DateTime
  totalPrice    Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(PENDING)
  notes         String?
  cancelReason  String?
  cancelledAt   DateTime?
  cancelledById String?
  userId        String
  courtId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  court Court @relation(fields: [courtId], references: [id])

  @@index([courtId, startAt, endAt])
  @@index([userId, createdAt])
  @@index([status, startAt])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  courtId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  court Court @relation(fields: [courtId], references: [id])

  @@unique([userId, courtId])
}
